# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
trash_rm_scripts/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# pwa
public/sw.js
public/workbox-*.js
public/worker-*.js

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Claude Code local
.claude/settings.local.json
.claude/

# Générés au build par next-sitemap (postbuild) — des SORTIES, pas des sources.
#
# Les versionner posait trois problèmes : le dépôt affichait l'ancien domaine
# alors que la configuration suit `NEXT_PUBLIC_SITE_URL` ; chaque build salissait
# le diff ; et si le postbuild venait à échouer, un robots.txt périmé annonçant
# le mauvais hôte serait servi en silence — le pire cas, parce qu'un fichier
# absent se remarque, un fichier faux non.
/public/robots.txt
/public/sitemap.xml
/public/sitemap-*.xml
